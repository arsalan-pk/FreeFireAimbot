<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.aimbot"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="33" />

    <!--
      PERMISSIONS
      ──────────────────────────────────────────────────────────────────────
      SYSTEM_ALERT_WINDOW  → Draw the aimbot overlay (floating button) on top
                             of other apps / games.  Must be requested at
                             runtime via Settings.ACTION_MANAGE_OVERLAY_PERMISSION.
      ACCESS_SUPERUSER     → Optional.  Only needed if you switch to root-based
                             InputManager injection (see aimbot.cpp comment).
                             Not required for the default AccessibilityService tap.
      FOREGROUND_SERVICE   → Keep the aimbot loop alive when the app is in
                             the background (Android 14+ requires this).
      POST_NOTIFICATIONS   → Required for the foreground service notification
                             on Android 13+.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.example.aimbot.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.aimbot.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" /> <!-- Optional: only needed for root-based input injection -->
    <!-- <uses-permission android:name="android.permission.ACCESS_SUPERUSER" /> -->
    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aimbot"
        android:usesCleartextTraffic="true" >

        <!-- ── Main / Launcher Activity ─────────────────────────────────── -->
        <activity
            android:name="com.example.aimbot.ColorTrackerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.aimbot.MainActivity"
            android:exported="true" />
        <activity
            android:name="com.example.aimbot.CapturePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          AccessibilityService
          flags:
            flagRetrieveInteractiveWindows → needed if you ever read window content.
            flagRequestTouchExplorationMode → enables gesture-based navigation.
            flagReportViewIds → not strictly needed but useful for debugging.
          performance:
            We do NOT request flagPerformGestures here — that flag requires Google
            to whitelist the app.  Instead we use our own dispatchGesture() in code,
            which works without the flag on most devices.
        -->
        <service
            android:name="com.example.aimbot.AimService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          ForegroundService — keeps the aimbot running in the background.
          type="specialUse" is required on Android 14+ (API 34).
        -->
        <service
            android:name="com.example.aimbot.AimService$AimForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="aimbot" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.aimbot.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>